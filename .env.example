# Kopieer naar .env op de server en vul een echt wachtwoord in.
# Zonder BUS_MONITOR_PASSWORD is er GEEN authenticatie -- verplicht instellen
# zodra de app vanaf het internet bereikbaar is.
BUS_MONITOR_USER=admin
BUS_MONITOR_PASSWORD=verzin-hier-een-sterk-wachtwoord

# Sleutel waarmee de inlogcookies ondertekend worden (zie app.secret_key in
# app/server.py). Genereer een eigen willekeurige waarde met:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# Bewust NIET van het wachtwoord afgeleid: dan is elk sessiecookie een offline
# orakel om dat wachtwoord op te kraken. Bij een ontbrekende waarde valt de app
# terug op die oude afleiding, dus zet hem op elke server expliciet.
BUS_MONITOR_SECRET_KEY=vul-hier-64-willekeurige-hextekens-in

# Optioneel: een tweede account (bv. een read-only kijker).
#BUS_MONITOR_USER2=Reader
#BUS_MONITOR_PASSWORD2=verzin-hier-een-sterk-wachtwoord

# NS Reisinformatie API-sleutel (apiportal.ns.nl), voor storingen op het
# spoor binnen de provincie Utrecht (zie app/ns_rail_alerts.py). Zonder deze
# key wordt die databron stilzwijgend overgeslagen -- de rest van de app
# blijft gewoon werken.
NS_API_KEY=vul-hier-je-ns-api-key-in

# KNMI Open Data API-sleutel (dataplatform.knmi.nl), voor weerwaarschuwingen
# in provincie Utrecht (zie app/knmi_warnings.py) en het actuele weer in
# De Bilt (zie app/knmi_weather.py). Let op: dit moet een key zijn met
# toegang tot de datasets "waarschuwingen_nederland_48h" en
# "10-minute-in-situ-meteorological-observations" -- niet elk KNMI-account/
# -key heeft dat automatisch, mogelijk eerst aan te vragen op het portaal.
# Zonder deze key worden die databronnen stilzwijgend overgeslagen.
KNMI_API_KEY=vul-hier-je-knmi-api-key-in
